# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_PORT=3100

# Storage inside Docker container
DB_PATH=/app/data/daohang.sqlite
DATA_DIR=/app/data
UPLOAD_DIR=/app/public/uploads
MAX_UPLOAD_BYTES=5242880

# Security: change before deployment
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_64_char_random_hex_string
# Initial admin password; only used when the SQLite database is created for the first time.
ADMIN_PASSWORD=change_this_admin_password
# Set true only when the app itself serves HTTPS. Behind HTTP localhost + Nginx HTTPS, keep false.
COOKIE_SECURE=false
TRUST_PROXY=true
