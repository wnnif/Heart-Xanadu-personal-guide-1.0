# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_PORT=3100

# Storage inside Docker container
DB_PATH=/app/data/daohang.sqlite
DATA_DIR=/app/data
UPLOAD_DIR=/app/public/uploads
MAX_UPLOAD_BYTES=5242880

# Security: change these before public deployment
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-strong-random-string
ADMIN_PASSWORD=123456
COOKIE_SECURE=false
TRUST_PROXY=true
